{
  "name": "@postgame/api",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "source": "./src/*.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./routers/*": {
      "source": "./src/routers/*.ts",
      "import": "./dist/routers/*.js",
      "default": "./dist/routers/*.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@postgame/lol-client": "workspace:*",
    "@postgame/auth": "workspace:*",
    "@postgame/db": "workspace:*",
    "colorthief": "^3.3.1",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@postgame/config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
